e search.prefix="1"
/x f0f0f0:4040f0
# Invalid flag value combination. Mask dominates.
e search.prefix="2"
/x f0f0f0:4141f1
e search.prefix="odd_mask"
/x f0f0f:647f0
# Custom flag with wildcard.
e search.overlap=false
e search.prefix="4142"
/x 4142:4142
